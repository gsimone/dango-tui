#!/bin/sh
# Example describe command for dango.json:
#   { "describe": "scripts/dango-describe" }
# or: dango --repo archetype-labs/app --describe scripts/dango-describe
#
# Reads {"titles":[...]} from stdin. Writes at most two inspector lines
# to stdout. Uses gpt-5.6 luna — not the Codex CLI default.
set -eu
input=$(cat)
exec codex exec \
  --quiet \
  --ephemeral \
  --sandbox read-only \
  --skip-git-repo-check \
  --ask-for-approval never \
  -m gpt-5.6-luna \
  "Write one short inspector blurb (at most two sentences) for this GitHub pull-request stack. Plain prose. No heading. Do not start with Covers. Do not mention CURSOR_AGENT. Do not paste a PR body. Layers: ${input}"
