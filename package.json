{
  "name": "stacks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "stacks": "bun --preload @opentui/solid/preload src/index.tsx",
    "stories": "bun --preload @opentui/solid/preload src/stories/index.tsx",
    "stories:web": "bun src/dev/terminal-web/server.ts",
    "test": "bun test --preload @opentui/solid/preload src/tests/app.test.tsx src/tests/displayState.test.ts src/tests/colors.test.ts",
    "test:web": "bun test --preload @opentui/solid/preload src/tests/terminal-web.test.ts src/tests/terminal-web-dimensions.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test",
    "check:web": "bun run check && bun run test:web"
  },
  "dependencies": {
    "@opentui/core": "0.5.6",
    "@opentui/solid": "0.5.6",
    "solid-js": "1.9.12",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "typescript": "5.9.3"
  }
}
